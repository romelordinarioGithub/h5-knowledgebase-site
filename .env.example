# Environment variables — copy to `.env` at repo root or `apps/web/.env.local`

# --- Frontend (apps/web) ---

# Catalog API base URL. Defaults to `/api/catalog` (proxied in dev via Vite).
# Production / GitHub Actions: set repository variable VITE_CATALOG_API_URL to:
#   https://h5-kb-api-proxy.vercel.app/api/catalog
# VITE_CATALOG_API_URL=

# API key sent as X-API-Key (must match Vercel env API_KEY).
# Also used as repository secret VITE_API_KEY for Deploy + Uptime workflows.
# VITE_API_KEY=

# Local dev: Vite proxy target for /api/* (vercel dev default port).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# --- Vercel API proxy (services/api-proxy) ---

# Required: Apps Script Web App /exec URL (JSON mode, no callback param).
# Set in Vercel Dashboard → Environment Variables, or:
#   cd services/api-proxy && npx vercel env add APPS_SCRIPT_URL
APPS_SCRIPT_URL=https://script.google.com/a/macros/smartly.io/s/AKfycbxTZ-z2N_lCuzSTsL9gGr2VnZWJ4AJf3PC9lzKQn0OQrYjbEf3UN5HzUWRYhevUZDhl/exec

# Required for production: clients must send matching X-API-Key
# npx vercel env add API_KEY

# Recommended: forwarded as ?key= to Apps Script (must match Script Property API_KEY)
# npx vercel env add APPS_SCRIPT_API_KEY

# Recommended: comma-separated browser origins (defaults to * if unset)
# CORS_ORIGINS=https://romelordinarioGithub.github.io

# Optional rate limit (defaults: 60 requests / 60000 ms per IP)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000

# --- GitHub Actions (Deploy / Uptime) — set in repo Settings, not in this file ---
# Secrets: VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, VITE_API_KEY
# Variables: VITE_CATALOG_API_URL
# Optional: UPTIME_CATALOG_URL (defaults to production catalog URL)
